# Generic Environment Configuration Example
# Note: Use placeholder values only. Never commit real keys, credentials, or URLs.

# Node & Orchestrator Environment
NODE_ENV=development
PORT=3000

# LLM Providers (Generic placeholders)
PRIMARY_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL & Vector Database
DATABASE_URL=postgresql://user:password@localhost:5432/example_db

# Supabase Storage & Database
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=example-anon-key-placeholder
